{
  "manifest_version": 2,
  "id": "wenaixi.mai_voice_speech_to_text",
  "version": "0.2.0",
  "name": "麦麦QQ语音实时转写文字听力",
  "description": "基于 SnowLuma 官方 fetch_ptt_text 原生接口，免模型免外部 API 实时将 QQ 语音消息转换为文字",
  "author": {
    "name": "Wenaixi",
    "url": "https://github.com/Wenaixi/mai-voice-speech-to-text"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Wenaixi/mai-voice-speech-to-text",
    "homepage": "https://github.com/Wenaixi/mai-voice-speech-to-text#readme",
    "documentation": "https://github.com/Wenaixi/mai-voice-speech-to-text/blob/main/README.md",
    "issues": "https://github.com/Wenaixi/mai-voice-speech-to-text/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "capabilities": [],
  "plugin_type": "media",
  "dependencies": [],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "display": {
    "icon": {
      "type": "emoji",
      "value": "🎙️",
      "background": "#F0E8F7"
    }
  }
}
